{
  "rules": {
    ".read": false,
    ".write": false,
    "lobby": {
      "random": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "!newData.exists() || (newData.hasChildren(['room', 'host', 'at']) && newData.child('host').val() === auth.uid)"
      }
    },
    "codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "$code.matches(/^[0-9]{4}$/) && (!newData.exists() || newData.hasChildren(['room', 'at']))"
      }
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && (!newData.exists() || newData.child('host').val() === auth.uid)) || data.child('host').val() === auth.uid || data.child('guest').val() === auth.uid || (!data.child('guest').exists() && data.child('status').val() === 'waiting' && newData.child('guest').val() === auth.uid))",
        "moves": {
          "$index": {
            ".validate": "!data.exists() && newData.child('by').val() === auth.uid && newData.child('m').isString() && newData.child('m').val().length <= 12"
          }
        },
        "online": {
          "$uid": {
            ".validate": "$uid === auth.uid || newData.val() === true"
          }
        },
        "resigned": {
          ".validate": "newData.val() === auth.uid"
        }
      }
    }
  }
}
